<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>I tuoi conti</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

<script>
  window.__CONTI__ = <%- JSON.stringify(conti) %>;
</script>

<body class="container">
  <div class="row">
    <h2 class="col">Seleziona il conto su cui vuoi lavorare</h2>
  </div>
  
  <div class="row">
    
    <% conti.forEach((conto, idx) => { %>
      <div class="col s4">
        <div class="card blue-grey darken-1">
          <div class="card-content white-text">
            <span class="card-title"><%= conto.titolo %></span>
            <div class="card-action">
              <a href="<%= conto.key %>/situazione-attuale">Vai al conto</a>
            </div>
          </div>
        </div>
      </div>

    <% }) %>
  </div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
