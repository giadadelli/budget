<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Situazione Finanziaria</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    body {
      font-family: sans-serif;
      padding: 2rem;
    }
    .section {
      margin-bottom: 3rem;
    }
    .grafici-container {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
    }
    .item {
      width: 200px;
      text-align: center;
    }
    canvas {
      max-width: 100%;
    }
    h3 {
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <h1>Saldo Totale: <%= data.saldo %>€</h1>

  <div class="section">
    <h2>Fondi</h2>
    <div class="grafici-container">
      <% data.fondi.forEach((fondo, index) => { %>
        <div class="item">
          <h3><%= fondo.nome %> – <%= fondo.attuale %>€</h3>
          <canvas id="fondoChart<%= index %>"></canvas>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="section">
    <h2>Buste</h2>
    <div class="grafici-container">
      <% data.buste.forEach((busta, index) => { %>
        <div class="item">
          <h3><%= busta.nome %> – <%= busta.attuale %>€</h3>
          <canvas id="bustaChart<%= index %>"></canvas>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="section">
    <h2>Avanzo</h2>
    <div class="grafici-container">
      <div class="item">
        <% 
          const sommaFondi = data.fondi.reduce((sum, f) => sum + f.attuale, 0);
          const sommaBuste = data.buste.reduce((sum, b) => sum + b.attuale, 0);
          const avanzo = data.saldo - sommaFondi - sommaBuste;
        %>
        <h3>Avanzo – <%= avanzo %>€</h3>
        <canvas id="avanzoChart"></canvas>
      </div>
    </div>
  </div>

  <script>
    const saldo = <%= data.saldo %>;
    const fondi = <%- JSON.stringify(data.fondi) %>;
    const buste = <%- JSON.stringify(data.buste) %>;
    const avanzo = saldo 
      - fondi.reduce((sum, f) => sum + f.attuale, 0)
      - buste.reduce((sum, b) => sum + b.attuale, 0);

    fondi.forEach((f, i) => {
      new Chart(document.getElementById('fondoChart' + i), {
        type: 'pie',
        data: {
          labels: ['Accantonato', 'Resto del saldo'],
          datasets: [{
            data: [f.attuale, saldo - f.attuale],
            backgroundColor: ['#4CAF50', '#ddd']
          }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
      });
    });

    buste.forEach((b, i) => {
      new Chart(document.getElementById('bustaChart' + i), {
        type: 'pie',
        data: {
          labels: ['Accantonato', 'Resto del saldo'],
          datasets: [{
            data: [b.attuale, saldo - b.attuale],
            backgroundColor: ['#2196F3', '#ddd']
          }]
        },
        options: { plugins: { legend: { position: 'bottom' } } }
      });
    });

    new Chart(document.getElementById('avanzoChart'), {
      type: 'pie',
      data: {
        labels: ['Avanzo', 'Somma Fondi + Buste'],
        datasets: [{
          data: [avanzo, saldo - avanzo],
          backgroundColor: ['#FF9800', '#ddd']
        }]
      },
      options: { plugins: { legend: { position: 'bottom' } } }
    });
  </script>
</body>
</html>
