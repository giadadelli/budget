<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Situazione Finanziaria</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="budget.css">

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
</head>

<script>
  window.__DATA__ = {
    fondi: <%- JSON.stringify(data.fondi) %>,
    buste: <%- JSON.stringify(data.buste) %>,
    attuali: Object.fromEntries(
      [...<%- JSON.stringify(data.fondi) %>, ...<%- JSON.stringify(data.buste) %>].map(x => [x.nome, x.attuale])
    )
  };
  window.__ACC__ = <%- JSON.stringify(accantonamenti) %>;
  window.__SOTTOCATEGORIE__ = <%- JSON.stringify(sottocategorie.sottocategorie) %>;
</script>

<body>
  <h1>Situazione Finanziaria</h1>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <p style="margin: 0;">
      <strong>Saldo:</strong> <%= data.saldo.toFixed(2) %> € 
      di cui disponibile <%= data.avanzo.toFixed(2) %> €
    </p>
  
    <div style="display: flex; gap: 0.5rem;">
      <a id="btn-apri-dialog-entrata" class="waves-effect waves-light btn">Nuova entrata</a>
      <a id="btn-apri-dialog" class="waves-effect waves-light btn">Traccia spese</a>
      
    </div>
  </div>
  
  
  <dialog id="dialog-spesa" class="rounded-xl p-4 border shadow-lg">
    <form id="form-spesa" method="dialog" class="flex flex-col gap-4">
      <div id="spese-container" class="flex flex-col gap-4", style="margin: 10px">
        <!-- righe di spesa inserite via JS -->
      </div>
    
      <button type="button" id="aggiungi-riga-spesa" class="bg-blue-200 text-blue-900 px-2 py-1 rounded self-start">
        + Aggiungi spesa
      </button>
    
      <div class="flex gap-2 justify-end">
        <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded">Salva</button>
        <button type="button" id="btn-chiudi-dialog" class="bg-gray-400 text-white px-3 py-1 rounded">Annulla</button>
      </div>
    </form>
    
  </dialog>

  <dialog id="dialog-entrata">
    <form id="form-entrata" method="dialog" class="flex flex-col gap-2">
      <label>
        Data:
        <input type="date" name="data" required class="border p-1 rounded w-full" />
      </label>
      <label>
        Importo:
        <input type="number" name="importo" step="0.01" required class="border p-1 rounded w-full" />
      </label>
      <label>
        Descrizione:
        <input type="text" name="descrizione" required class="border p-1 rounded w-full" />
      </label>
      <div class="flex gap-2 justify-end">
        <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded">Procedi</button>
        <button type="button" id="btn-chiudi-dialog-entrata" class="bg-gray-400 text-white px-3 py-1 rounded">Annulla</button>
      </div>
    </form>
  </dialog>

  <dialog id="dialog-smistamento">
    <div>
      <h3>Distribuisci l’importo</h3>
      <table class="w-full text-sm my-3">
        <thead>
          <tr>
            <th class="text-left">Categoria</th>
            <th class="text-right">Accantonato</th>
          </tr>
        </thead>
        <tbody id="smistamento-body">
          <!-- righe generate via JS -->
        </tbody>
        <tfoot>
          <tr>
            <td><strong>Non accantonato</strong></td>
            <td class="text-right"><strong id="non-accantonato">0.00 €</strong></td>
          </tr>
        </tfoot>
      </table>
      <div class="flex justify-end gap-2">
        <button type="button" id="btn-salva-smistamento" class="bg-green-600 text-white px-3 py-1 rounded">Salva</button>
        <button type="button" id="btn-chiudi-smistamento" class="bg-gray-400 text-white px-3 py-1 rounded">Annulla</button>
      </div>
      
    </div>
  </dialog>
  
  
  <h2>Fondi</h2>
  <div class="row">
    <% data.fondi.forEach((fondo, idx) => { %>
      <div class="chart-container">
        <strong style="color: <%= fondo.attuale >= fondo.obiettivo ? 'green' : 'red' %>">
          <%= fondo.titolo %>
        </strong><br />
        
        <small>
          <%= fondo.attuale.toFixed(2) %> €
          (Obiettivo: <%= fondo.obiettivo %> €)
        </small>
        <div style="background: #eee; height: 10px; border-radius: 6px; overflow: hidden; margin-top: 4px;">
          <div style="height: 100%; width: <%= Math.min(100, (fondo.attuale / fondo.obiettivo) * 100).toFixed(1) %>%; background-color: <%= fondo.attuale >= fondo.obiettivo ? '#4CAF50' : '#f87171' %>;">
          </div>
        </div>
        
        <canvas id="fondoChart<%= idx %>"></canvas>
      </div>
    <% }) %>
  </div>

  <h2>Buste</h2>
  <div class="row">
    <% data.buste.forEach((busta, idx) => { %>
      <div class="chart-container">
        <strong><%= busta.titolo %></strong><br />
        <small><%= busta.attuale.toFixed(2) %> €</small>
        <canvas id="bustaChart<%= idx %>"></canvas>
      </div>
    <% }) %>
  </div>

  <script>
    <% data.fondi.forEach((fondo, idx) => { %>
      new Chart(document.getElementById('fondoChart<%= idx %>'), {
        type: 'pie',
        data: {
          labels: ['<%= fondo.titolo %>', 'Resto'],
          datasets: [{
            data: [<%= fondo.attuale %>, <%= data.saldo - fondo.attuale %>],
            backgroundColor: ['#4CAF50', '#ddd']
          }]
        }
      });
    <% }) %>

    <% data.buste.forEach((busta, idx) => { %>
      new Chart(document.getElementById('bustaChart<%= idx %>'), {
        type: 'pie',
        data: {
          labels: ['<%= busta.titolo %>', 'Resto'],
          datasets: [{
            data: [<%= busta.attuale %>, <%= data.saldo - busta.attuale %>],
            backgroundColor: ['#2196F3', '#ddd']
          }]
        }
      });
    <% }) %>

  </script>
<script src="/script.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
