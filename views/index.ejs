<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Situazione Finanziaria</title>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  
  <style>
    body {
      font-family: sans-serif;
      padding: 2rem;
    }
    h2 {
      margin-top: 3rem;
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 2rem;
    }
    .chart-container {
      width: 250px;
      text-align: center;
    }
    canvas {
      max-width: 100%;
      height: auto;
    }
  </style>
</head>
<body>
  <h1>Situazione Finanziaria</h1>
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
    <p style="margin: 0;">
      <strong>Saldo:</strong> <%= data.saldo.toFixed(2) %> € 
      di cui disponibile <%= data.avanzo.toFixed(2) %> €
    </p>
  
    <button id="btn-apri-dialog" class="p-2 bg-blue-600 text-white rounded-xl">
      Aggiungi spesa
    </button>
  </div>
  
  <dialog id="dialog-spesa" class="rounded-xl p-4 border shadow-lg">
    <form id="form-spesa" method="dialog" class="flex flex-col gap-2">
      <label>
        Data:
        <input type="date" name="data" required class="border p-1 rounded w-full" />
      </label>
      <label>
        Importo:
        <input type="number" name="importo" step="0.01" required class="border p-1 rounded w-full" />
      </label>
      <label>
        Categoria:
        <select name="categoria" required class="border p-1 rounded w-full">
          <% data.fondi.concat(data.buste).forEach(c => { %>
            <option value="<%= c.nome %>"><%= c.nome %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Descrizione:
        <input type="text" name="descrizione" required class="border p-1 rounded w-full" />
      </label>
  
      <div class="flex gap-2 justify-end">
        <button type="submit" class="bg-green-600 text-white px-3 py-1 rounded">Salva</button>
        <button type="button" id="btn-chiudi-dialog" class="bg-gray-400 text-white px-3 py-1 rounded">Annulla</button>
      </div>
    </form>
  </dialog>
  
  <h2>Fondi</h2>
  <div class="row">
    <% data.fondi.forEach((fondo, idx) => { %>
      <div class="chart-container">
        <strong style="color: <%= fondo.attuale >= fondo.obiettivo ? 'green' : 'red' %>">
          <%= fondo.nome %>
        </strong><br />
        
        <small>
          <%= fondo.attuale.toFixed(2) %> €
          (Obiettivo: <%= fondo.obiettivo %> €)
        </small>
        
        <canvas id="fondoChart<%= idx %>"></canvas>
      </div>
    <% }) %>
  </div>

  <h2>Buste</h2>
  <div class="row">
    <% data.buste.forEach((busta, idx) => { %>
      <div class="chart-container">
        <strong><%= busta.nome %></strong><br />
        <small><%= busta.attuale.toFixed(2) %> €</small>
        <canvas id="bustaChart<%= idx %>"></canvas>
      </div>
    <% }) %>
  </div>

  <script>
    <% data.fondi.forEach((fondo, idx) => { %>
      new Chart(document.getElementById('fondoChart<%= idx %>'), {
        type: 'pie',
        data: {
          labels: ['<%= fondo.nome %>', 'Resto'],
          datasets: [{
            data: [<%= fondo.attuale %>, <%= data.saldo - fondo.attuale %>],
            backgroundColor: ['#4CAF50', '#ddd']
          }]
        }
      });
    <% }) %>

    <% data.buste.forEach((busta, idx) => { %>
      new Chart(document.getElementById('bustaChart<%= idx %>'), {
        type: 'pie',
        data: {
          labels: ['<%= busta.nome %>', 'Resto'],
          datasets: [{
            data: [<%= busta.attuale %>, <%= data.saldo - busta.attuale %>],
            backgroundColor: ['#2196F3', '#ddd']
          }]
        }
      });
    <% }) %>

  </script>
<script src="/script.js"></script>
</body>
</html>
