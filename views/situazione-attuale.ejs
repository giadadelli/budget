<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title><%= data.infoConto.titolo %></title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

<script>
  window.__CONTO__ = <%- JSON.stringify(conto) %>;
  window.__SALVADANAI__ = <%- JSON.stringify(salvadanai) %>;
</script>

<body class="">
  <div class="row">
    <div class="col">
      <a href="/" class="waves-effect orange darken-2 btn">Cambia conto</a>
    </div>
    <div class="col">
      <a href="movimenti" class="waves-effect orange darken-2 btn">Movimenti</a>
    </div>
  </div>
  
  <div class="row">
    <h2 class="col s12"><%= data.infoConto.titolo %></h2>
    <div class="row"><%= data.infoConto.descrizione %></div>
  </div>
  <div class="row">
    <div class="col">
      <h4>Saldo: <%= data.saldo.toFixed(2) %> € di cui disponibile <%= data.avanzo.toFixed(2) %> €</h4>
    </div> 
  </div>
   
  <div class="row">
    <% if (salvadanai.length == 0) { %>
      <h4>Non hai ancora iniziato a risparmiare</h4>
    <% } %>
  </div>
  <div class="row">
    <div class="col">
      <a id="btn-apri-dialog-entrata" class="waves-effect waves-light btn">Nuova entrata</a>
    </div>
    <div class="col">
      <a id="btn-apri-dialog-uscita" class="waves-effect waves-light btn">Registra spese</a>
    </div>
    <div class="col">
      <a id="btn-apri-dialog-salvadanaio" class="waves-effect waves-light btn">Crea salvadanaio</a>
    </div>
  </div>
    
  <dialog id="dialog-uscita" style="height: auto;">
    <form id="form-uscita" method="dialog" class="flex flex-col gap-2">
      <div id="rows-container">
        <!-- Popolato via js -->
      </div>
      
      <div class="row">
        <div class="col">
          <a id="aggiungi-uscita-riga" class="waves-effect waves-light btn">Aggiungi spesa</a>
        </div>
      </div>


      <div class="row">
        <div class="col s2">
          <a id="btn-chiudi-dialog-uscita" class="waves-effect waves-light btn">Annulla</a>
        </div>
        <div class="col s2 offset-s8">  
          <button class="btn waves-effect waves-light" type="submit" name="action" id="form-uscita_save_btn">Salva</button>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="dialog-entrata">
    <form id="form-entrata" method="dialog" class="flex flex-col gap-2">
      <div class="row">
        <div class="col">
          <select>
            <!-- <option value="" disabled selected>Tipologia entrata</option> -->
            <option value="stipendio">Stipendio</option>
            <!-- <option value="altro">Altro</option> -->
          </select>
        </div>
      </div>
      <div class="row">
        <div class="input-field col">
          <input type="text" class="datepicker" name="data_movimento">
          <label>Data</label>
        </div>
        <div class="input-field col">
          <input type="number" class="validate" name="importo" id="importo">
          <label>Importo</label>
        </div>
        <div class="input-field col">
          <input type="text" class="validate" name="descrizione">
          <label>Descrizione</label>
        </div>
      </div>
      
      <div class="divider"></div>
        <div class="row">
          <h6 class="col s12">Distribuzione tra i tuoi salvadanai</h6>
          <div class="col">Ti viene suggerito di accantonare nei salvadanai dove hai impostato accantonamento ad ogni stipendio e non hai ancora raggiunto l'obiettivo (oppure non hai impostato un obiettivo)</div>
        </div>
        <div class="row">
          <% salvadanai.forEach((salvadanaio, idx) => { %>
            <% if (salvadanaio.frequenza == 'stipendio' && !salvadanaio.obiettivo_raggiunto) { %>
              <div class="input-field col">
                <input class="importo_da_accantonare" name="<%= salvadanaio.id %>" type="number" class="validate" value="<%= salvadanaio.importo_ricorrente %>">
                <label><%= salvadanaio.titolo %></label>
              </div>
            <% } %>
          <% }) %>
        </div>
      <div class="divider"></div>
      <div class="row">
        <div class="col">
          Totale non accantonato (aumenterà la tua disponibilità): <span id="totale_non_accantonato"></span>
        </div>
      </div>

      <div class="row">
        <div class="col s2">
          <a id="btn-chiudi-dialog-entrata" class="waves-effect waves-light btn">Annulla</a>
        </div>
        <div class="col s2 offset-s8">  
          <button class="btn waves-effect waves-light" type="submit" name="action" id="form-entrata_save_btn">Salva</button>
        </div>
      </div>
    </form>
  </dialog>  

  <dialog id="dialog-crea-salvadanaio" class="rounded-xl p-4 border shadow-lg" style="width: 600px;">
    <form id="form-salvadanaio" method="dialog" class="flex flex-col gap-4">
      <div class="flex flex-col gap-4", style="margin: 10px">
        <div class="row">
          <div class="input-field col s12">
            <input id="titolo" type="text" class="validate">
            <label>Nome</label>
          </div>
        </div>
        <div class="divider"></div>
        <div class="row">
          <div class="input-field col s12">
            <input id="iniziale" type="number" step="0.01" class="validate">
            <label>Importo iniziale</label>
          </div>
        </div>
        <div class="divider"></div>
        <div class="row">
          <div class="input-field col s12">
            <input id="obiettivo" type="number" step="0.01" class="validate">
            <label >Obiettivo</label>
          </div>
        </div>
        <div class="divider"></div>
        <div class="row">
          <div class="input-field col s12">
            <input id="importo_ricorrente" type="number" step="0.01" class="validate">
            <label>Accantonamento ad ogni stipendio</label>
          </div>
        </div>
      </div>
    
    
      <div class="flex gap-2 justify-end" style="display: flex; justify-content: space-between;">
        <a id="btn-chiudi-dialog-salvadanaio" class="waves-effect waves-light btn">Annulla</a>
        
        <button class="btn waves-effect waves-light" type="submit" name="action">Salva
          <i class="material-icons right">save</i>
        </button>
      </div>
    </form>
    
  </dialog>   
<div class="row">
  <% if (salvadanaiNew.length != 0) { %>
    <div class="row">
      <div class="col">
        <h4>I tuoi salvadanai</h4>
      </div> 
    </div>
    <%  Object.keys(salvadanaiNew).forEach((key, idx) => { %>
      <div class="col s2">
        <div class="card teal darken-1">
          <div class="card-content white-text">
            <span class="card-title" style="text-transform: capitalize"><%= key %></span>
            <%  salvadanaiNew[key].forEach((salvadanaio, idx) => { %>
              <div class="row">
                <div class="col">
                  <%= salvadanaio.titolo %>: <%= salvadanaio.saldo %>  €
                  <% if (typeof salvadanaio.obiettivo == 'number') { %>
                    / <%= salvadanaio.obiettivo %> €
                  <% } %> <!-- End if -->
                  <div> 
                    <% if (typeof salvadanaio.importo_ricorrente == 'number') { %>
                      <%= salvadanaio.importo_ricorrente %> € ad ogni stipendio
                    <% } %>
                    <% if (typeof salvadanaio.importo_ricorrente !== 'number') { %>
                      Accantonamento manuale
                    <% } %>
                  </div>
                </div>
              </div>
            <% }) %> <!-- End foreach salvadanaiNew[key] -->
          </div>
        </div>
      </div>

    <% }) %> <!-- End foreach salvadanaiNew -->


  <% } %>  <!-- End if -->
</div>
  

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
  <script src="/aggiungi-uscita.js"></script>
  <script src="/aggiungi-entrata.js"></script>
  <script src="/aggiungi-salvadanaio.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('.datepicker');
      var instances = M.Datepicker.init(elems, {autoClose: true, defaultDate: new Date(), format: "yyyy-mm-dd"});
    });

    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('select');
      var instances = M.FormSelect.init(elems, {});
    });

    document.addEventListener('DOMContentLoaded', function() {
      var elems = document.querySelectorAll('.tooltipped');
      var instances = M.Tooltip.init(elems, {});
    });
  </script>
</body>
</html>
