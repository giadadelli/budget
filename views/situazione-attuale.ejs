<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <title>Situazione Finanziaria</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>

<script>
  window.__CONTO__ = <%- JSON.stringify(conto) %>;
</script>

<body class="">
  <div class="row">
    <h2 class="col">Situazione Finanziaria</h2>
  </div>
  <div class="row">
    <div class="col">
      <h4>Saldo: <%= data.saldo.toFixed(2) %> € di cui disponibile <%= data.avanzo.toFixed(2) %> €</h4>
    </div> 
  </div>
  <div class="divider"></div>
   
    <div class="row">
      <% if (salvadanai.length == 0) { %>
        <h4>Non hai ancora iniziato a risparmiare</h4>
      <% } %>
      <div class="row">
        <div class="col">
          <a id="btn-apri-dialog-salvadanaio" class="waves-effect waves-light btn">Crea salvadanaio</a>
        </div>
      </div>
      
      
      <dialog id="dialog-crea-salvadanaio" class="rounded-xl p-4 border shadow-lg">
        <form id="form-salvadanaio" method="dialog" class="flex flex-col gap-4">
          <div class="flex flex-col gap-4", style="margin: 10px">
            titolo,obiettivo,importo-ricorrente,frequenza,inserito
            <div class="row">
              <div class="input-field col s4">
                <input id="titolo" type="text" class="validate">
                <label>Nome</label>
              </div>
            </div>
            <div class="row">
              <div class="input-field col s4">
                <input id="obiettivo" type="number" class="validate">
                <label >Obiettivo</label>
              </div>
              <div class="input-field col s4">
                <input id="iniziale" type="number" class="validate">
                <label >Importo iniziale</label>
              </div>
              TODO aggiungere import per trasferimento ricorrente
            </div>
          </div>
        
        
          <div class="flex gap-2 justify-end" style="display: flex; justify-content: space-between;">
            <a id="btn-chiudi-dialog-salvadanaio" class="waves-effect waves-light btn">Annulla</a>
            
            <button class="btn waves-effect waves-light" type="submit" name="action">Salva
              <i class="material-icons right">save</i>
            </button>
          </div>
        </form>
        
      </dialog>      
    </div>
    <div class="row">
      <% if (salvadanai.length != 0) { %>
        <div class="row">
          <div class="col">
            <h4>I tuoi salvadanai</h4>
          </div> 
        </div>
        <% salvadanai.forEach((salvadanaio, idx) => { %>
          <div class="col">
            <div class="card teal darken-1">
              <div class="card-content white-text">
                <span class="card-title"><%= salvadanaio.titolo %></span>
                <div> 
                  <%= salvadanaio.saldo %>  € 
                  <% if (salvadanai.obiettivo != 0) { %>
                    / <%= salvadanaio.obiettivo %> €
                  <% } %>
              </div>
              </div>
            </div>
          </div>
  
        <% }) %>
      <% } %>
    </div>

<script src="/situazione-attuale.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
